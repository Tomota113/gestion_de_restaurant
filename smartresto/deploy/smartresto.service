[Unit]
Description=SmartResto local restaurant server
After=network.target

[Service]
Type=simple
User=smartresto
Group=smartresto
WorkingDirectory=/opt/smartresto
EnvironmentFile=/opt/smartresto/.env
Environment=SMARTRESTO_SECURE_COOKIE=1
ExecStart=/opt/smartresto/.venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --ws-max-size 16384
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/smartresto/data
UMask=0077

[Install]
WantedBy=multi-user.target
